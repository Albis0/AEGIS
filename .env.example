# AEGIS — developer .env template
#
# NORMAL USERS DON'T NEED THIS FILE. The installed app is configured entirely
# through Onboarding + Settings (trial mode needs zero keys; advanced mode
# takes your Groq key in the UI and stores it DPAPI-encrypted in ~/.aegis).
# This file only exists for developers running from source who want keys in
# the environment instead of the settings UI.

# ── Groq (recommended for development) ──────────────────────────────────────
# https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...

# ── Supabase (OPTIONAL — only for self-hosting your own cloud backend) ──────
# The shipped app uses the bundled public AEGIS project (anon key + RLS) for
# trial mode & sync. Set these ONLY if you run your own Supabase project
# (schema: supabase/schema.sql). service_role key — never the anon key here.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Web search (OPTIONAL — DuckDuckGo fallback is used without them) ────────
# Tavily — https://app.tavily.com → API Keys
TAVILY_API_KEY=tvly-...
# Serper (Google search) — https://serper.dev → API Key
SERPER_API_KEY=...

# ── Alternative AI providers (OPTIONAL) ─────────────────────────────────────
# Most users enter these in-app: Settings → API Keys.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...
DEEPSEEK_API_KEY=...
MISTRAL_API_KEY=...

# ── Spotify (OPTIONAL) ──────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app
# Redirect URI: http://localhost:17832/callback
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# ── ElevenLabs TTS (OPTIONAL) ───────────────────────────────────────────────
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=...

# ── GitHub update check (OPTIONAL, private-repo builds only) ────────────────
# NOT needed for the public repo. Read-only PAT for pulling releases from a
# private repo. NEVER embedded in code — passed via build/runtime env only.
AEGIS_GITHUB_TOKEN=
