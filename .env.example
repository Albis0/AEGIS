# ── Groq (ZORUNLU) ──────────────────────────────────────────────────────────
# https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...

# ── Supabase (ZORUNLU) ──────────────────────────────────────────────────────
# https://supabase.com → New Project → Settings → API
# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (anon key DEĞİL — Settings > API > service_role)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Web Arama (OPSİYONEL) ───────────────────────────────────────────────────
# İkisi de yoksa DuckDuckGo fallback'i kullanılır (sınırlı)

# Tavily — https://app.tavily.com → API Keys
TAVILY_API_KEY=tvly-...

# Serper (Google arama) — https://serper.dev → API Key
SERPER_API_KEY=...

# ── Alternatif AI Provider'lar (OPSİYONEL) ──────────────────────────────────
# Çoğu kullanıcı bunları uygulama içi Ayarlar → API Anahtarları'ndan girer.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...
DEEPSEEK_API_KEY=...
MISTRAL_API_KEY=...

# ── Spotify (OPSİYONEL) ─────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app
# Redirect URI: http://localhost:17832/callback
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# ── ElevenLabs TTS (OPSİYONEL) ──────────────────────────────────────────────
# https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=...

# ── GitHub güncelleme kontrolü (OPSİYONEL, yalnızca private repo build'leri) ─
# Public repo'da GEREKMEZ. Private repo'dan release çekmek için read-only PAT.
# Koda ASLA gömülmez — yalnızca build/runtime env üzerinden geçirilir.
AEGIS_GITHUB_TOKEN=
