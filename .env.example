# ── Groq (ZORUNLU) ──────────────────────────────────────────────────────────
# https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...

# ── Supabase (ZORUNLU) ──────────────────────────────────────────────────────
# https://supabase.com → New Project → Settings → API
# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (anon key DEĞİL — Settings > API > service_role)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Web Arama (OPSİYONEL) ───────────────────────────────────────────────────
# İkisi de yoksa DuckDuckGo fallback'i kullanılır (sınırlı)

# Tavily — https://app.tavily.com → API Keys
TAVILY_API_KEY=tvly-...

# Serper (Google arama) — https://serper.dev → API Key
SERPER_API_KEY=...
