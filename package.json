{
  "name": "real-jarvis",
  "version": "1.3.15",
  "description": "Windows için kişisel AI asistanı — konuşma tanıma, 150+ araç, çoklu LLM desteği",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.electron.json && cross-env ELECTRON_RUN_AS_NODE= node launch-electron.js",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"bun run dev:vite\" \"wait-on tcp:127.0.0.1:5173 && bun run dev:electron\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "electron:build": "bun run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.106.2",
    "electron-updater": "^6.8.3",
    "groq-sdk": "^1.2.1",
    "kokoro-js": "^1.2.1",
    "msedge-tts": "^2.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "electron": "31.7.7",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aegis",
    "productName": "AEGIS",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "!dist-electron/**/*.map"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AEGIS"
    },
    "publish": {
      "provider": "github",
      "owner": "Albis0",
      "repo": "AEGIS",
      "releaseType": "release"
    }
  }
}
