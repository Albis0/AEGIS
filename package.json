{
  "name": "real-jarvis",
  "version": "1.0.0",
  "description": "Your personal AI assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.electron.json && node launch-electron.js",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"wait-on tcp:127.0.0.1:5173 && npm run dev:electron\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^16.4.5",
    "groq-sdk": "^1.2.1",
    "msedge-tts": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aegis",
    "productName": "AEGIS",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
